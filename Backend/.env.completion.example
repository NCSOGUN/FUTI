# Existing HealthPass settings
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/healthpass
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5500
 
# OpenAI-compatible Chat Completions endpoint; key stays on the server.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=replace-with-your-provider-secret
AI_MODEL=replace-with-a-supported-model
AI_TIMEOUT_MS=20000
AI_CHAT_RETENTION_DAYS=30
 
# Email delivery for daily inventory digests (optional during local development)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=HealthPass Alerts <alerts@example.com>
 
# Daily inventory alerts; timezone should be Africa/Lagos for Nigerian clinics.
ENABLE_INVENTORY_ALERTS=false
INVENTORY_ALERT_CRON=0 7 * * *
APP_TIMEZONE=Africa/Lagos
API_RATE_LIMIT=300