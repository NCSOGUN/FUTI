PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/healthpass
JWT_SECRET=replace-with-a-long-random-secret
# OpenAI-compatible chat completions endpoint. Keep keys on the server only.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=replace-with-your-provider-secret
AI_MODEL=replace-with-a-supported-model
# Configure CORS_ORIGIN to your exact deployed frontend origin.
CORS_ORIGIN=http://localhost:5500